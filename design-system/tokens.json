{
  "color-fg": {
    "$type": "color",
    "$description": "Primary text color on light surfaces",
    "$value": { "colorSpace": "srgb", "components": [0.1176, 0.1608, 0.2314], "hex": "#1e293b" }
  },
  "color-bg": {
    "$type": "color",
    "$description": "Default page/app background",
    "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" }
  },
  "color-bg-subtle": {
    "$type": "color",
    "$description": "Secondary surface used for panels and alternating rows",
    "$value": { "colorSpace": "srgb", "components": [0.9725, 0.9804, 0.9882], "hex": "#f8fafc" }
  },
  "color-primary": {
    "$type": "color",
    "$description": "Brand/action color for primary buttons and links",
    "$value": { "colorSpace": "srgb", "components": [0.1451, 0.3882, 0.9216], "hex": "#2563eb" }
  },
  "color-primary-hover": {
    "$type": "color",
    "$description": "Hover state for primary actions",
    "$value": { "colorSpace": "srgb", "components": [0.1137, 0.3059, 0.8471], "hex": "#1d4ed8" }
  },
  "color-primary-fg": {
    "$type": "color",
    "$description": "Text/icon color on top of primary-colored surfaces",
    "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" }
  },
  "color-border": {
    "$type": "color",
    "$description": "Default border color for inputs, cards and dividers",
    "$value": { "colorSpace": "srgb", "components": [0.8863, 0.9098, 0.9412], "hex": "#e2e8f0" }
  },
  "color-fg-muted": {
    "$type": "color",
    "$description": "Secondary text color for captions and helper text",
    "$value": { "colorSpace": "srgb", "components": [0.4039, 0.4549, 0.5451], "hex": "#67748b" }
  },
  "color-success": {
    "$type": "color",
    "$description": "Positive status and success chip color",
    "$value": { "colorSpace": "srgb", "components": [0.0863, 0.5961, 0.3608], "hex": "#16985c" }
  },
  "color-success-bg": {
    "$type": "color",
    "$description": "Background for success chips",
    "$value": { "colorSpace": "srgb", "components": [0.8824, 0.9647, 0.9098], "hex": "#e1f6e8" }
  },
  "color-danger": {
    "$type": "color",
    "$description": "Destructive action and error status color",
    "$value": { "colorSpace": "srgb", "components": [0.8588, 0.1529, 0.1529], "hex": "#db2727" }
  },
  "color-danger-bg": {
    "$type": "color",
    "$description": "Background for danger/error chips",
    "$value": { "colorSpace": "srgb", "components": [0.9922, 0.898, 0.898], "hex": "#fde5e5" }
  },
  "color-warning": {
    "$type": "color",
    "$description": "Warning status color",
    "$value": { "colorSpace": "srgb", "components": [0.7059, 0.4549, 0.0235], "hex": "#b47406" }
  },
  "color-warning-bg": {
    "$type": "color",
    "$description": "Background for warning chips",
    "$value": { "colorSpace": "srgb", "components": [0.9961, 0.9529, 0.8392], "hex": "#fef3d6" }
  },
  "font-family-base": {
    "$type": "fontFamily",
    "$description": "Default UI typeface",
    "$value": "Inter, ui-sans-serif, system-ui, sans-serif"
  },
  "font-family-mono": {
    "$type": "fontFamily",
    "$description": "Monospace typeface for code and identifiers",
    "$value": "'JetBrains Mono', ui-monospace, SFMono-Regular, monospace"
  },
  "font-weight-regular": {
    "$type": "fontWeight",
    "$value": 400
  },
  "font-weight-medium": {
    "$type": "fontWeight",
    "$value": 500
  },
  "font-weight-semibold": {
    "$type": "fontWeight",
    "$value": 600
  },
  "line-height-base": {
    "$type": "number",
    "$description": "Default line-height multiplier for body text",
    "$value": 1.5
  },
  "font-size-sm": {
    "$type": "dimension",
    "$description": "Helper text, captions, chip labels",
    "$value": { "value": 12, "unit": "px" }
  },
  "font-size-md": {
    "$type": "dimension",
    "$description": "Default body and control text",
    "$value": { "value": 14, "unit": "px" }
  },
  "font-size-lg": {
    "$type": "dimension",
    "$description": "Section headings",
    "$value": { "value": 18, "unit": "px" }
  },
  "space-1": {
    "$type": "dimension",
    "$description": "Tightest spacing, icon-to-label gaps",
    "$value": { "value": 4, "unit": "px" }
  },
  "space-2": {
    "$type": "dimension",
    "$description": "Compact spacing inside controls",
    "$value": { "value": 8, "unit": "px" }
  },
  "space-3": {
    "$type": "dimension",
    "$description": "Default spacing between stacked elements",
    "$value": { "value": 12, "unit": "px" }
  },
  "space-4": {
    "$type": "dimension",
    "$description": "Section and card padding",
    "$value": { "value": 16, "unit": "px" }
  },
  "radius-sm": {
    "$type": "dimension",
    "$description": "Chips and small controls",
    "$value": { "value": 4, "unit": "px" }
  },
  "radius-md": {
    "$type": "dimension",
    "$description": "Buttons and inputs",
    "$value": { "value": 6, "unit": "px" }
  },
  "radius-lg": {
    "$type": "dimension",
    "$description": "Cards and panels",
    "$value": { "value": 10, "unit": "px" }
  },
  "shadow-card": {
    "$type": "shadow",
    "$description": "Resting elevation for cards",
    "$value": {
      "color": { "colorSpace": "srgb", "components": [0.1176, 0.1608, 0.2314], "hex": "#1e293b", "alpha": 0.08 },
      "offsetX": { "value": 0, "unit": "px" },
      "offsetY": { "value": 1, "unit": "px" },
      "blur": { "value": 3, "unit": "px" },
      "spread": { "value": 0, "unit": "px" }
    }
  },
  "border-default": {
    "$type": "border",
    "$description": "Default 1px hairline border",
    "$value": {
      "color": { "colorSpace": "srgb", "components": [0.8863, 0.9098, 0.9412], "hex": "#e2e8f0" },
      "width": { "value": 1, "unit": "px" },
      "style": "solid"
    }
  },
  "button-primary-background": {
    "$type": "color",
    "$value": "{color-primary}"
  },
  "button-primary-background-hover": {
    "$type": "color",
    "$value": "{color-primary-hover}"
  },
  "button-primary-foreground": {
    "$type": "color",
    "$value": "{color-primary-fg}"
  },
  "button-primary-radius": {
    "$type": "dimension",
    "$value": "{radius-md}"
  },
  "button-primary-padding-y": {
    "$type": "dimension",
    "$value": "{space-2}"
  },
  "button-primary-padding-x": {
    "$type": "dimension",
    "$value": "{space-4}"
  },
  "button-secondary-background": {
    "$type": "color",
    "$value": "{color-bg}"
  },
  "button-secondary-foreground": {
    "$type": "color",
    "$value": "{color-fg}"
  },
  "button-secondary-border": {
    "$type": "color",
    "$value": "{color-border}"
  },
  "card-default-background": {
    "$type": "color",
    "$value": "{color-bg}"
  },
  "card-default-border": {
    "$type": "color",
    "$value": "{color-border}"
  },
  "card-default-radius": {
    "$type": "dimension",
    "$value": "{radius-lg}"
  },
  "card-default-padding": {
    "$type": "dimension",
    "$value": "{space-4}"
  }
}
